# Local signing credentials for build-install.ps1
#
# Copy this file to "local-creds.env" (same directory) and fill in your values.
# local-creds.env is gitignored and must never be committed.
#
# NOTE: keep this file ASCII-only.
#   Windows PowerShell 5.1 decodes BOM-less files with the ANSI code page, so
#   non-ASCII bytes get mis-decoded and can silently corrupt a line.
#
# If these four variables are already set in the environment, build-install.ps1
# leaves them untouched.
#
# build.gradle.kts resolves the release signing config in this order:
#   1. these WEKIT_* environment variables
#   2. the same names as gradle properties (e.g. -PWEKIT_KEYSTORE_FILE=...)
#   3. default keystore paths: ~/wcx-keystore.jks, ~/.wcx/wcx-keystore.jks,
#      <repo>/wcx-keystore.jks   (alias=wcx, store/key password=wcx-store-pass)
#   4. Android's debug keystore - produces a debug-signed APK that can neither
#      overwrite an install signed with the release key nor be distributed.

WEKIT_KEYSTORE_FILE=D:\path\to\your-release.jks
WEKIT_KEYSTORE_PASSWORD=change-me
WEKIT_KEY_ALIAS=your-alias
WEKIT_KEY_PASSWORD=change-me
